# ── Better Class ─────────────────────────────────────────────
# Copie para .env  (cp .env.example .env)

PORT=3000
HOST=0.0.0.0

# Segredo usado para assinar os cookies de sessão.
# Opcional: se ficar vazio, o servidor gera um na primeira subida e guarda em
# <DATA_DIR>/.session-secret — as sessões continuam valendo depois de reiniciar.
# Para definir o seu: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── IA (opcional) ────────────────────────────────────────────
# Sem chave o app continua 100% funcional usando o motor local
# de resumo (extrativo). Com chave, os resumos são gerados pelo Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Transcrição no servidor (opcional) ───────────────────────
# Qualquer endpoint compatível com a API de transcrição da OpenAI
# (Whisper, Groq, LocalAI...). Vazio = usa a transcrição ao vivo
# do navegador (Web Speech API), que já vem ligada por padrão.
TRANSCRIBE_URL=
TRANSCRIBE_KEY=
TRANSCRIBE_MODEL=whisper-1

# Limite de upload por pedaço de áudio (bytes)
MAX_CHUNK_BYTES=15728640
